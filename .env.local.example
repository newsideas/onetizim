# Supabase (https://app.supabase.com -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Telegram bot (https://t.me/BotFather orqali yaratiladi)
# Server-only — NEXT_PUBLIC_ prefiksi YO'Q, brauzerga chiqmaydi
TELEGRAM_BOT_TOKEN=

# Webhook'ni faqat Telegram chaqira olishi uchun maxfiy kalit.
# Ixtiyoriy matn (masalan: openssl rand -hex 16), setWebhook'da ham
# aynan shu qiymat beriladi.
TELEGRAM_WEBHOOK_SECRET=

# Bot username (@ belgisisiz) — ota-onalar uchun ulash havolalarida
# ishlatiladi, maxfiy emas
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
