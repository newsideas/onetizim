# Supabase (https://app.supabase.com -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Faqat serverda: maktab ro'yxatdan o'tkazish va xodim hisoblarini yaratish uchun.
# "service_role" (secret) kalit — NEXT_PUBLIC_ prefiksi YO'Q, hech qachon brauzerga/git'ga chiqmasin.
SUPABASE_SERVICE_ROLE_KEY=

# Asosiy saytdagi "Bog'lanish" tugmasi: mijoz o'zi ro'yxatdan o'tmaydi, biz bilan bog'lanadi.
# Telegram havolasi (https://t.me/...) ustuvor; bo'lmasa telefon. Ikkalasi bo'sh bo'lsa tugma chiqmaydi.
NEXT_PUBLIC_CONTACT_TELEGRAM=
NEXT_PUBLIC_CONTACT_PHONE=

# Telegram bot (https://t.me/BotFather orqali yaratiladi)
# Server-only — NEXT_PUBLIC_ prefiksi YO'Q, brauzerga chiqmaydi
TELEGRAM_BOT_TOKEN=

# Webhook'ni faqat Telegram chaqira olishi uchun maxfiy kalit.
# Ixtiyoriy matn (masalan: openssl rand -hex 16), setWebhook'da ham
# aynan shu qiymat beriladi.
TELEGRAM_WEBHOOK_SECRET=

# Bot username (@ belgisisiz) — ota-onalar uchun ulash havolalarida
# ishlatiladi, maxfiy emas
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# SMS-gateway (masalan SMSAPI.UZ, Eskiz.uz). Hali ulanmagan — kiritilsa
# ham hech narsa yubormaydi, faqat Xabarnomalar > SMS sahifasida
# "ulangan" holatini ko'rsatadi. Haqiqiy yuborish keyingi bosqichda.
SMS_PROVIDER_API_KEY=

# Asosiy domen (maktab subdomenlari va admin.<domen> shundan hosil bo'ladi).
# Mahalliy ishlab chiqishda: localhost; ishlab chiqarishda: edugram.uz
NEXT_PUBLIC_ROOT_DOMAIN=localhost
